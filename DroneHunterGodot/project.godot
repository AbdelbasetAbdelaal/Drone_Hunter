; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text editor.

config_version=5

[application]

config/name="Drone Hunter 2D"
config/description="Fast-paced 2D sci-fi tactical arcade space shooter"
config/version="1.0.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/player/player_idle.png"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

